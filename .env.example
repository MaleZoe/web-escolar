# ARCHIVO: .env.example. Plantilla de variables, sin secretos. El archivo .env real no se sube.

# Variables de entorno para Base de Datos MySQL (Vercel / Railway / Render / Nube)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=web_escolar_db
DB_PORT=3306

# Opcionales
# DB_SSL_VERIFY=1          Verifica el certificado de la base remota. Probar antes en el entorno real.
# DB_SSL_CA=/ruta/ca.pem   Certificado de la autoridad, si el del sistema no sirve.
# TRUST_CLOUDFLARE=1       Solo si TODO el tráfico pasa por Cloudflare.
# ADMIN_ALERT_EMAIL=correo@ejemplo.com  Activa la ruta rotativa del panel en Vercel y recibe cada enlace.
# RESEND_API_KEY=re_xxx               Envía el enlace por Resend en lugar de FormSubmit.
# RESEND_FROM=Panel <avisos@dominio>   Remitente, si verificaste un dominio en Resend.
# PANEL_BASE_URL=https://dominio.com    Dominio con el que se arma el enlace del correo.
# CONTACT_USE_PHP_MAIL=1   Envía también con mail(). Duplica el correo si sigue activo FormSubmit.
