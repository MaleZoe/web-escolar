{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/sys-control-98/css/(.*)",
      "dest": "/sys-control-98/css/$1"
    },
    {
      "src": "/sys-control-98/js/(.*)",
      "dest": "/sys-control-98/js/$1"
    },
    {
      "src": "/sys-control-98(.*)",
      "dest": "/api/admin.php"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
