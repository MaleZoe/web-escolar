*.zip
*.tar.gz
*.rar
zip.zip
tec.zip
*.mp4
video web.mp4

# Dependencias Node.js
node_modules/
package-lock.json

# Variables de entorno locales
.env
.env.local
.env.*.local

# Archivos del sistema operativo y editores
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
